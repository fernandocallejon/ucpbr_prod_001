# ============================================================
# RetailNexus — Environment Variables
# Copy to local.settings.json (Azure Functions) or .env
# ============================================================

# ─── Azure Cosmos DB ───
COSMOS_ENDPOINT=https://retailnexus-dev-cosmos.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key-here
COSMOS_DATABASE=retailnexus

# ─── Azure Redis Cache ───
REDIS_URL=rediss://:your-redis-key@retailnexus-dev-redis.redis.cache.windows.net:6380

# ─── Azure Service Bus ───
SERVICE_BUS_CONNECTION=Endpoint=sb://retailnexus-dev-sb.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key

# ─── JWT Authentication ───
JWT_SECRET=your-jwt-secret-min-32-chars-long-change-this
JWT_EXPIRY=24h

# ─── API2Cart (E-commerce Bridge) ───
# Get your key at: https://api2cart.com
API2CART_API_KEY=your-api2cart-key
API2CART_BASE_URL=https://api.api2cart.com/v1.1

# ─── Serper API (Competitive Intelligence) ───
# Get your key at: https://serper.dev
SERPER_API_KEY=your-serper-key
SERPER_BASE_URL=https://google.serper.dev

# ─── Google APIs ───
# Content API for Shopping + Indexing API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://retailnexus-dev-api.azurewebsites.net/api/google/callback
GOOGLE_MERCHANT_ID=your-merchant-center-id
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_INDEXING_QUOTA_PER_DAY=200

# ─── Stripe (Billing) ───
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ─── Application Insights ───
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://brazilsouth-1.in.applicationinsights.azure.com/

# ─── General ───
NODE_ENV=development
